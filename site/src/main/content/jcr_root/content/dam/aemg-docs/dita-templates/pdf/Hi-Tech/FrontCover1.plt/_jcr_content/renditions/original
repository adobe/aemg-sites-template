<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <link rel="stylesheet" href="layout.css" type="text/css"/>
    <meta name="page-style" content="size:A4 portrait;background-color:#032E61;margin-left:40px;margin-right:40px;margin-top:125px;margin-bottom:58px;"/>
    <title>Page Layout</title>
    <meta name="footnote-style" content=""/>
  </head>
  <body>
    <div data-region="header">
      <div class="header-front-1">
        <div class="header-front-1__container" style="">
          <img alt="Project Logo" class="header-front-1__logo" src="project-logo.png"/>
        </div>
      </div>
    </div>
    <div data-region="content">
      <div class="content-front-1">
        <div class="content-front-1__text">
          <span class="content-front-1__title" data-field="project-title" data-format="default">PROJECT TITLE</span>
          <div class="content-front-1__divider"></div>
          <span class="content-front-1__description" data-keyref="proj-description" style="">User Guide</span>
        </div>
        <img class="content-front-1__image" src="front-1-image.png"/>
      </div>
    </div>
    <div data-region="footer">
      <div class="footer-front-1">
        <div class="footer-front-1__container">
          <span data-keyref="copyright-info">Copyright © 2024 Adobe Inc.</span>
          <span data-keyref="foot-note"> All rights reserved</span>
        </div>
      </div>
    </div>
  </body>
</html>