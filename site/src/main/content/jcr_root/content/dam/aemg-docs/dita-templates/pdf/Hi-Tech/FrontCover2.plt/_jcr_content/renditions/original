<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <link rel="stylesheet" href="layout.css" type="text/css"/>
    <meta name="page-style" content="size:A4 portrait;margin-top:91px;margin-bottom:79px;margin-left:0px;margin-right:0px;"/>
    <title>Page Layout</title>
    <meta name="footnote-style" content=""/>
  </head>
  <body>
    <div data-region="header">
      <div class="header-front-2">
        <div class="header-front-2__border-top">
          <br/>
        </div>
        <div class="header-front-2__container">
          <img alt="Project Logo" class="header-front-2__logo" src="project-logo.png"/>
        </div>
      </div>
    </div>
    <div data-region="content">
      <div class="content-front-2">
        <img class="content-front-2__image" src="front-cover-img.png"/>
        <div class="content-front-2__text">
          <span class="content-front-2__title" data-field="project-title" data-format="default">PROJECT TITLE</span>
          <span class="content-front-2__description" data-keyref="proj-description" style="">User Guide</span>
        </div>
      </div>
    </div>
    <div data-region="footer">
      <div class="footer-front-2">
        <div class="footer-front-2__container">
          <span data-keyref="copyright-info">Copyright © 2024 Adobe Inc.</span>
          <span data-keyref="foot-note"> All rights reserved</span>
        </div>
      </div>
    </div>
  </body>
</html>