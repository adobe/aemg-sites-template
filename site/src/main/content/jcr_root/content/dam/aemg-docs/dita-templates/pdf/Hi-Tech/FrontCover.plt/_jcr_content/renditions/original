<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <link rel="stylesheet" href="layout.css" type="text/css"/>
    <meta name="page-style" content="margin-top:0px;margin-right:0px;margin-bottom:0px;margin-left:0px;"/>
    <title>Front Cover Page</title>
    <meta name="footnote-style" content=""/>
  </head>
  <body>
    <div style="position: absolute; height: 4px; top:0; left: 0; right: 0; background: linear-gradient(90deg, #10B2B4, #0078AD);">
      <br/>
    </div>
    <div style="position: absolute; top: 26px; left: 36px;">
      <img src="project-logo.png" style="vertical-align: middle; height: 35px;"/>
    </div>
    <div style="position: absolute; top: 87px; left: 36px;">
      <img src="front-cover-img.png" style="cursor: nwse-resize;"/>
      <div style="display: flex; flex-direction: column; gap: 20px; padding: 14px; margin: 0 18px; border-radius: 12px; background: #ffffff; z-index: 10; position: relative; top: -48px; box-shadow: 0px 12px 20px -12px #0D0A2C14;">
        <span data-field="map-title" data-format="default" style="font-size: 24px;font-weight: 600; line-height: 46px; color: #0078AD; background: linear-gradient(90deg, #10B2B4, #0078AD); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Map Title</span>
        <span data-keyref="proj-description" style="font-size: 16px; line-height: 24px; font-weight: 600; color: #000000;">User Guide</span>
      </div>
    </div>
    <div style="position: absolute; bottom: 0px; left: 40px; right: 40px; display: flex; justify-content: space-between; padding: 46px 0 14px; border-top: 1px solid; border-color: #F2F2F2;">
      <span data-keyref="copyright-info" style="font-size: 13px; font-weight: 300; line-height: 18px;">Copyright © 2024 Adobe Inc.</span>
      <span data-keyref="foot-note" style="font-size: 13px; font-weight: 300; line-height: 18px;"> All rights reserved</span>
    </div>
  </body>
</html>