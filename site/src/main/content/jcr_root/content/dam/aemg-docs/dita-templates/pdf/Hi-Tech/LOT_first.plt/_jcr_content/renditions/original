<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <title>List of Tables Page Layout</title>
    <link rel="stylesheet" href="layout.css" type="text/css"/>
    <link rel="stylesheet" type="text/css" href="content.css"/>
    <meta name="page-style" content="margin-top:87px;margin-bottom:96px;margin-left:0px;margin-right:0px;"/>
    <meta name="footnote-style" content=""/>
  </head>
  <body>
    <div data-region="header">
      <div class="header right-page">
        <div class="header__border-top">
          <br/>
        </div>
        <div class="header__container">
          <img alt="Header Logo" class="header__logo" src="project-logo.png"/>
          <div class="header__info">
            <div class="header__details">
              <span class="header__description" data-keyref="proj-description" style="">User Guide</span>
              <div class="header__divider"></div>
              <span class="header__language" data-keyref="language-en" style="">EN</span>
            </div>
            <span class="header__title" data-field="project-title" data-format="default">PROJECT TITLE</span>
          </div>
        </div>
      </div>
    </div>
    <div data-region="content" style="margin: 0 36px;">
      <div class="content-section content-section--lot">
        <img class="content-section__image" alt="LOT Logo" src="front-cover-img.png"/>
        <div class="content-section__text">
          <span class="content-section__title">List of Tables</span>
          <div class="content-section__divider"></div>
          <span class="content-section__description" data-keyref="proj-description" style="">User Guide</span>
        </div>
      </div>
      <p class="content-section__page-title">List of Tables</p>
    </div>
    <div data-region="footer">
      <div class="footer right-page">
        <span class="footer__page-number" data-field="page-number" data-format="default">1</span>
        <p class="footer-line" style=""></p>
        <p class="footer__chapter">
          <span class="footer__chapter-label">Chapter</span>
          <span class="footer__chapter-number" data-field="chapter-number" data-format="default">1</span>
        </p>
      </div>
    </div>
  </body>
</html>