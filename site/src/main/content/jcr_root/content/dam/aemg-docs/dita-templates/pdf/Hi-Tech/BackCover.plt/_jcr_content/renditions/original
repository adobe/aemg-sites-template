<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
  <head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <link rel="stylesheet" href="layout.css" type="text/css"/>
    <title>Back Cover Layout</title>
    <meta name="page-style" content="margin-top:40px;margin-right:40px;margin-bottom:51px;margin-left:40px;"/>
    <meta name="footnote-style" content=""/>
  </head>
  <body>
    <div data-region="header">
      <br/>
    </div>
    <div data-region="content" style="">
      <div class="content-back-1">
        <img class="content-back-1__image" src="front-cover-img.png"/>
        <div class="content-back-1__details">
          <div class="content-back-1__info">
            <img alt="Project Logo" class="content-back-1__logo" src="project-logo.png"/>
            <div class="content-back-1__socials">
              <span class="content-back-1__social">Twitter</span>
              <span class="content-back-1__social">Facebook</span>
              <span class="content-back-1__social">Linkedin</span>
            </div>
          </div>
          <div class="content-back-1__address">
            <span class="content-back-1__address-item">Street Name 4,</span>
            <span class="content-back-1__address-item">67133 City,</span>
            <span class="content-back-1__address-item">Country</span>
          </div>
        </div>
      </div>
    </div>
    <div data-region="footer">
      <div class="footer-back-1">
        <div class="footer-back-1__container">
          <span data-keyref="copyright-info">Copyright © 2024 Adobe Inc.</span>
          <span data-keyref="foot-note"> All rights reserved</span>
        </div>
      </div>
    </div>
  </body>
</html>