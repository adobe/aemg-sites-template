/*Fonts*/
@import url("https://use.typekit.net/vul1wum.css");
@font-face {
  font-family: 'Outfit';
  src: url('outfit-variable.woff2') format('woff2');
  font-weight: 100 900;
  font-style: normal;
}
/*Variables*/
:root {
  /*Color Variables*/
  --black-color: #000000;
  --white-color: #ffffff;
  --red-color: #ff0000;
  --primary-blue: #0C9FDE;
  --secondary-blue: #2BABE2;
  --teal-blue: #10B2B4;
  --dark-blue: #0078AD;
  --navy-blue: #0074D9;
  --light-gray: #F4F4F4;
  --medium-gray: #DEDEDE;
  /*  */
  --heading-level-1-color: var(--primary-blue);
  --heading-level-2-color: var(--secondary-blue);
  --heading-level-3-color: var(--black-color);
  --paragraph-color: var(--black-color);
  --body-color: var(--black-color);
  --short-description-color: var(--black-color);
  --table-title-color: var(--secondary-blue);
  --table-border-color: var(--medium-gray);
  --note-background-color: var(--light-gray);
  /*Font Size Variables*/
  --fs-h1: 24pt;
  --fs-h2: 20pt;
  --lh-h2: 25pt;
  --fs-h3: 18pt;
  --lh-h3: 23pt;
  --fs-h4: 16pt;
  --lh-h4: 20pt;
  --fw-h4: 600;
  --fs-h5: 14pt;
  --lh-h5: 18pt;
  --fw-h5: 500;
  --fs-h6: 12pt;
  --lh-h6: 16pt;
  --fw-h6: 400;
  --font-size-p: 12pt;
  --line-height-p: 18pt;
  --font-weight-p: 400;
  --font-size-body: 12pt;
  --line-height-body: 18pt;
  --font-weight-body: 400;
  --font-size-short-desc: 12pt;
  --font-size-table-title: 15pt;
  --font-size-figure-title: 15pt;
}
body {
  font-family: Outfit, sans-serif;
  color: var(--black-color);
  font-size: var(--font-size-body);
  line-height: var(--line-height-body);
  font-weight: var(--font-weight-body);
}
/**** Heading Styles ****/
h1 {
  font-size: var(--fs-h1);
}
h2 {
  font-size: var(--fs-h2);
  line-height: var(--lh-h2);
}
h3 {
  font-size: var(--fs-h3);
  line-height: var(--lh-h3);
}
h4 {
  font-size: var(--fs-h4);
  line-height: var(--lh-h4);
  font-weight: var(--fw-h4);
}
h5 {
  font-size: var(--fs-h5);
  line-height: var(--lh-h5);
  font-weight: var(--fw-h5);
}
h6 {
  font-size: var(--fs-h6);
  line-height: var(--lh-h6);
  font-weight: var(--fw-h6);
}
h1.chapter {
  --autonumber: autonumber;
  --prefix-size: 22.5pt;
  --prefix-fixed-size: true;
  --prefix-gap: 3pt;
  --list-indent: 0pt;
  position: relative;
  column-span: all;
  font-weight: 500;
  color: var(--heading-level-1-color);
  text-align: center;
  margin-top: 7.5pt;
  margin-bottom: 24pt;
}
h1.chapter:before {
  content: counter(chapCounter, decimal)". ";
  text-align: center;
  margin-right: var(--prefix-gap);
  overflow: hidden;
}
h2.chapter {
  --autonumber: autonumber;
  --prefix-size: 35pt;
  --prefix-fixed-size: true;
  --prefix-gap: 3pt;
  --list-indent: 0pt;
  counter-increment: h2-chapter;
  position: relative;
  column-span: all;
  font-weight: 500;
  color: var(--heading-level-2-color);
  margin-top: 20pt;
  margin-bottom: 20pt;
  margin-left: calc(var(--list-indent) + var(--prefix-size) + var(--prefix-gap));
}
h2.chapter:before {
  content: counter(chapCounter) "." counter(h2-chapter) ". ";
  text-align: left;
  position: absolute;
  left: calc(-1 * var(--prefix-size) - var(--prefix-gap));
  margin-right: var(--prefix-gap);
  width: var(--prefix-size);
  overflow: hidden;
}
h3.chapter {
  --autonumber: autonumber;
  --prefix-size: 50pt;
  --prefix-fixed-size: true;
  --prefix-gap: 3pt;
  --list-indent: 0pt;
  counter-reset: h4-chapter;
  position: relative;
  column-span: all;
  font-weight: 500;
  color: var(--heading-level-3-color);
  margin-top: 16pt;
  margin-bottom: 16pt;
  margin-left: calc(var(--list-indent) + var(--prefix-size) + var(--prefix-gap));
}
h3.chapter:before {
  counter-increment: h3-chapter;
  content: counter(chapCounter) "." counter(h2-chapter) "." counter(h3-chapter) ". ";
  text-align: left;
  position: absolute;
  left: calc(-1 * var(--prefix-size) - var(--prefix-gap));
  margin-right: var(--prefix-gap);
  width: var(--prefix-size);
  overflow: hidden;
}
h1.appendix {}
/*Content Body Styles*/
div[rh-toc-item-level="1"] {
  counter-reset: h2-chapter;
}
div[rh-toc-item-level="2"] {
  counter-reset: h3-chapter;
}
.topic-body[rh-toc-item-level="3"] {
  margin-left: 38pt;
}
.troublebody {
  margin-left: 38pt;
}
/**** Paragraph Styles ****/
p {
  font-size: var(--font-size-p);
}
.p {
  font-size: var(--font-size-p);
  line-height: var(--line-height-p);
  font-weight: var(--font-weight-p);
  color: var(--paragraph-color);
  margin: 18pt 0;
}
div.p {
  margin-bottom: 18pt;
}
div.p:last-child {
  /* margin: 18pt 0; */
}
.draft-comment {
  display: none;
}
.p .ul {
  margin-top: 4pt;
}
/* .p .ul .li:first-of-type {
  margin-top: 9pt;
} */
.pre {}
.shortdesc {
  font-size: var(--font-size-short-desc);
  color: var(--short-description-color);
  line-height: 18pt;
  font-weight: 300;
  margin: 18pt 0;
}
/**** Link Styles ****/
a {
  text-decoration: underline;
}
.link {
  display: block;
}
.link>.desc {
  display: none;
}
.related-links {
  margin-top: 1rem;
}
.relatedlinks .link {
  display: block;
  margin-bottom: 0.2rem;
}
.xref {
  color: var(--navy-blue);
  text-decoration: none;
}
.xref[data-attr-href=""]::after {
    content: " (Reference not authored)";
    color: var(--red-color);
    font-style: italic;
}
/**** List Styles ****/
ul,
ol {
  padding-bottom: 0em;
  margin: 18pt 0;
}
li {
  font-size: 12pt;
  line-height: 18pt;
  margin: 18pt 0;
}
ul {
  list-style-type: disc;
}
ol {
  list-style-type: decimal;
}
ol ul {
  list-style-type: disc;
}
ul ul {
  list-style-type: circle;
}
ul ol,
ol ol {
  list-style-type: lower-alpha;
}
ol ol ol {
  list-style-type: lower-roman;
}
/**** Table Styles ****/
table {
  width: 100%;
  font-size: 10pt;
  line-height: 15pt;
  font-weight: 400;
  border-collapse: collapse;
}
table .title {
  font-size: var(--font-size-table-title);
  line-height: 15pt;
  font-weight: 500;
  color: var(--table-title-color);
  margin-bottom: 7.5pt;
  margin-top: 18pt;
}
table li {
  font-size: 10pt;
  line-height: 15pt;
  font-weight: 400;
}
table ul {
  margin-top: 4pt;
  margin-bottom: 4pt;
}
table .p {
  font-size: 10pt;
  line-height: 15pt;
  font-weight: 400;
  margin: 0;
}
.tgroup {
  text-align: start;
  table-layout: fixed;
  word-break: break-all;
  word-break: break-word;
}
.thead {
  text-align: left;
  background: linear-gradient(90deg, var(--teal-blue), var(--dark-blue));
  color: var(--white-color);
}
.row {}
.entry {
  padding: 9pt 18pt 9pt 9pt;
  vertical-align: top;
  border: 1px solid var(--medium-gray);
}
/**** Simple Table Styles ****/
.simpletable {}
.sthead {
  text-align: left;
  background: linear-gradient(90deg, var(--teal-blue), var(--dark-blue));
  color: var(--white-color);
}
.strow {
  vertical-align: top;
}
.stentry {
  padding: 9pt 18pt 9pt 9pt;
  border: 1px solid var(--medium-gray);
}
thead .stentry {
  font-size: 8.25pt;
  line-height: 16.5pt;
  font-weight: 600;
  padding: 4.5pt 7.5pt 7.5pt 9pt;
}
/**** Figure & Image Styles ****/
.fig {
  text-align: center;
}
.fig .title {
  font-size: var(--font-size-figure-title);
  font-weight: bold;
  margin-bottom: 14pt;
  margin-top: 14pt;
}
.figgroup {}
.image {
  max-width: 100%;
  display: block;
  margin: 0 auto;
}
.svg-container {
  display: inline-block;
}
video {
  max-height: 100%;
  max-width: 100%;
}
/**** Note Styles ****/
.note {
  background-color: var(--note-background-color);
  padding: 7.5pt 7.5pt 7.5pt 28.5pt;
  position: relative;
  font-size: 10.5pt;
  line-height: 16.5pt;
  font-weight: 400;
  margin-top: 18pt;
  margin-bottom: 18pt;
}
.note::before {
  content: "";
  display: inline-block;
  position: absolute;
  left: 7.5pt;
  top: 7.5pt;
  width: 13.5pt;
  height: 13.5pt;
  background-image: url('note-icon.png');
  background-size: contain;
  background-repeat: no-repeat;
  /* margin-right: 7.5pt; */
  vertical-align: middle;
}
.note .prefix-content {
  font-weight: 700;
}
.note.caution {
  background-color: #fff9e5;
  border-left-color: #f5c823;
}
.note.danger {
  background-color: #fff0f0;
  border-left-color: #ffd7d6;
}
.note.notice {
  background-color: #f6f9fc;
  border-left-color: #e4edf6;
}
.note.warning {
  background-color: #ffeddf;
  border-left-color: #ffb47b;
}
.hazardstatement.attention,
.hazardstatement.fastpath,
.hazardstatement.note,
.hazardstatement.important,
.hazardstatement.notice,
.hazardstatement.other,
.hazardstatement.remember,
.hazardstatement.restriction,
.hazardstatement.tip {
  background: #F8F8F8 0% 0% no-repeat padding-box;
  border: 1px solid #6D6D6D;
}
.hazardstatement {
  width: 29.188rem;
  border-radius: 4px;
  opacity: 1;
  padding: 16px;
  font-size: 14px;
}
.hazardstatement td,
.hazardstatement th {
  padding: 0.5rem;
}
.hazardstatement th {
  text-align: center;
  text-transform: uppercase;
}
.hazardstatement.caution {
  background: #FFECCC 0% 0% no-repeat padding-box;
  border: 1px solid #F68511;
}
.hazardstatement .prefix-content {
  background-position: 0 0;
  padding-left: 1.5rem;
  background: transparent url("AlertSmall.svg") 0% 0% no-repeat padding-box;
  font-weight: bold;
  vertical-align: middle;
}
.hazardstatement .messagepanel {
  list-style-type: none;
  padding-inline-start: 1.5rem;
}
.hazardstatement.danger {
  background: #FFEBE7 0% 0% no-repeat padding-box;
  border: 1px solid #EA3829;
}
.hazardstatement.warning {
  background-color: #ffeddf;
  border: 1px solid #ffb47b;
}
