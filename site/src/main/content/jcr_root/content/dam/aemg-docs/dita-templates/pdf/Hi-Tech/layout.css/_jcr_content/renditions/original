/*TOC Styling*/
.toc-header {
  font-weight: bold;
  font-size: 12pt;
}
.toc-footer {
  font-weight: bold;
  font-size: 12pt;
  text-align: center;
}
.toc-body {}
.toc-title {
  font-size: 24px;
  font-weight: 500;
  margin-top: 10px;
  margin-bottom: 20px;
  line-height: 36px;
  color: var(--page-title-color);
}
.toc-level-1 {
  font-size: 16px;
  line-height: 20px;
  font-weight: 600;
  color: var(--toc-level-1-color);
  text-decoration: none;
  margin-top: 16px;
  counter-increment: toc-level-1;
  counter-reset: toc-level-2;
}
.toc-level-1::before {
  content: counter(toc-level-1) ". ";
  display: inline-block;
  width: 16px;
  text-align: right;
  padding-right: 6px;
}
/* .toc-level-1::after {
  content: leader(dashed) " " target-counter(attr(href url), page, decimal) !important;
} */
/* .toc-level-1::after {
  content: leader(dotted) " " target-counter(attr(href url), page, decimal) !important;
} */
/* .toc-level-1::after {
  content: " " target-counter(attr(href url), page, decimal) !important;
  position: absolute;
  right: 0;
} */
/* .toc-level-1::after {
  content: leader(solid) " " target-counter(attr(href url), chapCounter, lower-roman) "-" target-counter(attr(href url), page, decimal) !important;
} */
.toc-level-1::after {
  content: leader(space) " " target-counter(attr(href url), page, decimal) !important;
  font-size: 14.5px;
}
.toc-level-1.front-matter {
  display: none;
}
.toc-level-1.front-matter::after {
  display: none;
}
.toc-level-2 {
  font-size: 14px;
  text-decoration: none;
  line-height: 18px;
  font-weight: 400;
  color: #000;
  counter-increment: toc-level-2;
  counter-reset: toc-level-3;
  text-indent: 0;
  margin-left: 22px;
  margin-top: 12px;
}
.toc-level-2::before {
  content: counter(toc-level-1) "." counter(toc-level-2) " ";
  display: inline-block;
  width: 30px;
  text-align: left;
}
.toc-level-3 {
  font-size: 14px;
  text-decoration: none;
  line-height: 18px;
  font-weight: 400;
  color: #000;
  text-indent: 0;
  margin-left: 52px;
  margin-top: 12px;
  counter-increment: toc-level-3;
  counter-reset: toc-level-4;
}
.toc-level-3::before {
  content: counter(toc-level-1) "." counter(toc-level-2) "." counter(toc-level-3) " ";
  display: inline-block;
  width: 40px;
  text-align: left;
}
.toc-level-4 {
  font-size: 14px;
  text-decoration: none;
  line-height: 18px;
  font-weight: 400;
  color: #000;
  text-indent: 0;
  margin-left: 92px;
  margin-top: 12px;
  counter-increment: toc-level-4;
}
.toc-level-4::before {
  content: counter(toc-level-1) "." counter(toc-level-2) "." counter(toc-level-3) "." counter(toc-level-4) " ";
  display: inline-block;
  width: 56px;
  text-align: left;
}
.toc-level-5 {
  font-size: 11pt;
  text-decoration: none;
  line-height: 18pt;
}
.toc-level-6 {
  font-size: 10pt;
  text-decoration: none;
  line-height: 16pt;
}
/*Chapter TOC Styling*/
.chaptoc-body {}
.chaptoc-level-1 {
