<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/aemg-docs/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="マップサイドバー"
        sling:resourceType="cq/experience-fragments/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="core/wcm/components/container/v1/container"
            layout="simple">
            <kb-download-card jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/container/v1/container" id="kb-download-card">
                <download-icon jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/container/v1/container" id="kb-download-icon"/>
                <download-title jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/text/v2/text" text="RoboHelpをダウンロード" textIsRich="false" id="kb-download-title"/>
                <download-text jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/text/v2/text" text="&lt;p>最新のRoboHelpリリース用インストーラーを入手して、複数のタッチポイントにわたるコンテンツのオーサリングと公開を開始できます。&lt;/p>" textIsRich="true" id="kb-download-text"/>
                <download-btn jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/text/v2/text" text="&lt;p>&lt;a href='/content/dam/robohelp/en/user-guide/introduction/robohelp-downloads.dita'>RoboHelpをダウンロード&lt;/a>&lt;/p>" textIsRich="true" id="kb-download-btn"/>
            </kb-download-card>
            <kb-sidebar-cards-row jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/container/v1/container" id="kb-sidebar-cards-row">
                <kb-community-card jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/container/v1/container" id="kb-community-card">
                    <community-icon jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/container/v1/container" id="kb-community-icon"/>
                    <community-title jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/text/v2/text" text="RoboHelpコミュニティ" textIsRich="false" id="kb-community-title"/>
                    <community-text jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/text/v2/text" text="&lt;p>Adobeコミュニティに参加して、世界中のクリエイター仲間と学び、作り、つながりましょう。&lt;/p>" textIsRich="true" id="kb-community-text"/>
                    <community-link jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/text/v2/text" text="&lt;p>&lt;a href='https://community.adobe.com/robohelp-748'>RoboHelp コミュニティにアクセス &amp;gt;&lt;/a>&lt;/p>" textIsRich="true" id="kb-community-link"/>
                </kb-community-card>
                <kb-contact-card jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/container/v1/container" id="kb-contact-card">
                    <contact-icon jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/container/v1/container" id="kb-contact-icon"/>
                    <contact-title jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/text/v2/text" text="専門家のサポートを受ける" textIsRich="false" id="kb-contact-title"/>
                    <contact-text jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/text/v2/text" text="&lt;p>RoboHelpのインストール、ライセンス、技術的な質問についてAdobeに問い合わせることができます。&lt;/p>" textIsRich="true" id="kb-contact-text"/>
                    <contact-link jcr:primaryType="nt:unstructured" sling:resourceType="core/wcm/components/text/v2/text" text="&lt;p>&lt;a href='https://helpx.adobe.com/tech-comm-suite/customer-support.html'>サポートに問い合わせる ／&lt;/a>&lt;/p>" textIsRich="true" id="kb-contact-link"/>
                </kb-contact-card>
            </kb-sidebar-cards-row>
        </root>
    </jcr:content>
</jcr:root>
