<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/aemg-docs/settings/wcm/templates/hitech-xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Header"
        sling:resourceType="guides-components/components/guides-pages/hitech/hitech-guides-xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="guides-components/components/container"
            layout="simple">
            <header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/header"
                darkLogo="/content/dam/aemg-docs/common-images/icons/Logo-dark-theme.svg"
                languageIcon="/content/dam/aemg-docs/asset.jpg"
                lightLogo="/content/dam/aemg-docs/common-images/icons/Logo.svg"
                logo="/content/dam/aemg-docs/common-images/icons/logo.svg"
                logoLink="#"
                placeholderText="Search Here"
                profileIcon="/content/dam/aemg-docs/asset.jpg"
                searchIcon="/content/dam/aemg-docs/common-images/icons/search.svg"
                themeIcon="/content/dam/aemg-docs/asset.jpg">
                <search
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="guides-components/components/search2"
                    searchIcon="/content/dam/aemg-docs/common-images/icons/search.svg"
                    searchRoot="/content/aemg-docs/hitech"/>
                <ctaList jcr:primaryType="nt:unstructured">
                    <item0
                        jcr:primaryType="nt:unstructured"
                        ctaLabel="Company"
                        ctaLink="#"/>
                    <item1
                        jcr:primaryType="nt:unstructured"
                        ctaLabel="Customer"
                        ctaLink="#"/>
                    <item2
                        jcr:primaryType="nt:unstructured"
                        ctaLabel="Support"
                        ctaLink="#"/>
                </ctaList>
            </header>
        </root>
    </jcr:content>
</jcr:root>
