<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/aemg-docs/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Map sidebar"
        sling:resourceType="cq/experience-fragments/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="core/wcm/components/container/v1/container"
            layout="simple">
            <kb-download-card
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/wcm/components/container/v1/container"
                id="kb-download-card">
                <download-icon
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="kb-download-icon"/>
                <download-title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/text/v2/text"
                    text="Jetzt FrameMaker herunterladen"
                    textIsRich="false"
                    id="kb-download-title"/>
                <download-text
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/text/v2/text"
                    text="&lt;p>Hol dir das Installationsprogramm für die neueste FrameMaker-Version und beginne mit dem Erstellen und Veröffentlichen von Inhalten über mehrere Touchpoints hinweg.&lt;/p>"
                    textIsRich="true"
                    id="kb-download-text"/>
                <download-btn
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/text/v2/text"
                    text="&lt;p>&lt;a href='/content/framemaker-docs/de/docs/user-guide/framemaker-downloads.html'>Jetzt FrameMaker herunterladen&lt;/a>&lt;/p>"
                    textIsRich="true"
                    id="kb-download-btn"/>
            </kb-download-card>
            <kb-sidebar-cards-row
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/wcm/components/container/v1/container"
                id="kb-sidebar-cards-row">
                <kb-community-card
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="kb-community-card">
                    <community-icon
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/container/v1/container"
                        id="kb-community-icon"/>
                    <community-title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="FrameMaker-Community"
                        textIsRich="false"
                        id="kb-community-title"/>
                    <community-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>Treten Sie der Adobe Community bei, um sich fortzubilden, Inhalte zu erstellen und sich mit anderen Kreativen aus aller Welt zu vernetzen.&lt;/p>"
                        textIsRich="true"
                        id="kb-community-text"/>
                    <community-link
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>&lt;a href='https://community.adobe.com/framemaker-641'>FrameMaker-Community besuchen &amp;gt;&lt;/a>&lt;/p>"
                        textIsRich="true"
                        id="kb-community-link"/>
                </kb-community-card>
                <kb-contact-card
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="kb-contact-card">
                    <contact-icon
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/container/v1/container"
                        id="kb-contact-icon"/>
                    <contact-title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="Jetzt Expertenhilfe erhalten"
                        textIsRich="false"
                        id="kb-contact-title"/>
                    <contact-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>Sprich mit Adobe über die Installation von FrameMaker, die Lizenzierung und technische Fragen.&lt;/p>"
                        textIsRich="true"
                        id="kb-contact-text"/>
                    <contact-link
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>&lt;a href='https://helpx.adobe.com/tech-comm-suite/customer-support.html'>Support kontaktieren &amp;amp;gt;&lt;/a>&lt;/p>"
                        textIsRich="true"
                        id="kb-contact-link"/>
                </kb-contact-card>
            </kb-sidebar-cards-row>
        </root>
    </jcr:content>
</jcr:root>
