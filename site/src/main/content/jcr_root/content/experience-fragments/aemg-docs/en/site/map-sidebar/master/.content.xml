<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:tags="[]"
        cq:template="/conf/aemg-docs/settings/wcm/templates/xf-web-variation"
        cq:xfMasterVariation="{Boolean}true"
        cq:xfVariantType="web"
        jcr:primaryType="cq:PageContent"
        jcr:title="Map sidebar"
        sling:resourceType="cq/experience-fragments/components/xfpage">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="core/wcm/components/container/v1/container"
            layout="simple">
            <kb-download-card
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/wcm/components/container/v1/container"
                id="kb-download-card">
                <download-icon
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="kb-download-icon"/>
                <download-title
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/text/v2/text"
                    text="Download RoboHelp"
                    textIsRich="false"
                    id="kb-download-title"/>
                <download-text
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/text/v2/text"
                    text="&lt;p>Get the installers for the latest RoboHelp release and start authoring and publishing content across multiple touchpoints.&lt;/p>"
                    textIsRich="true"
                    id="kb-download-text"/>
                <download-btn
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/text/v2/text"
                    text="&lt;p>&lt;a href='/content/dam/robohelp/en/user-guide/introduction/robohelp-downloads.dita'>Download RoboHelp&lt;/a>&lt;/p>"
                    textIsRich="true"
                    id="kb-download-btn"/>
            </kb-download-card>
            <kb-sidebar-cards-row
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/wcm/components/container/v1/container"
                id="kb-sidebar-cards-row">
                <kb-community-card
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="kb-community-card">
                    <community-icon
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/container/v1/container"
                        id="kb-community-icon"/>
                    <community-title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="RoboHelp Community"
                        textIsRich="false"
                        id="kb-community-title"/>
                    <community-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>Join the Adobe Community to learn, create, and connect with fellow creators from around the world.&lt;/p>"
                        textIsRich="true"
                        id="kb-community-text"/>
                    <community-link
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>&lt;a href='https://community.adobe.com/robohelp-748'>Visit RoboHelp community &amp;gt;&lt;/a>&lt;/p>"
                        textIsRich="true"
                        id="kb-community-link"/>
                </kb-community-card>
                <kb-contact-card
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="kb-contact-card">
                    <contact-icon
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/container/v1/container"
                        id="kb-contact-icon"/>
                    <contact-title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="Get expert help"
                        textIsRich="false"
                        id="kb-contact-title"/>
                    <contact-text
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>Talk to Adobe about RoboHelp installation, licensing, and technical questions.&lt;/p>"
                        textIsRich="true"
                        id="kb-contact-text"/>
                    <contact-link
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>&lt;a href='https://helpx.adobe.com/tech-comm-suite/customer-support.html'>Contact support &amp;gt;&lt;/a>&lt;/p>"
                        textIsRich="true"
                        id="kb-contact-link"/>
                </kb-contact-card>
            </kb-sidebar-cards-row>
        </root>
    </jcr:content>
</jcr:root>
