<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="cq:Page">
    <jcr:content
            cq:template="/conf/aemg-docs/settings/wcm/templates/hitech-guides-landing-page"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="guides-components/components/guides-pages/hitech/hitech-guides-landing-page">
        <root
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/container"
                layout="responsiveGrid">
            <breadcrumb_copy
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="guides-components/components/breadcrumb2"
                    disableShadowing="false"
                    hideCurrent="false"
                    showHidden="false"
                    startLevel="5"/>
            <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="guides-components/components/container">
                <toc_component
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="guides-components/components/toc"/>
            </container>
        </root>
        <cq:responsive jcr:primaryType="nt:unstructured">
            <breakpoints jcr:primaryType="nt:unstructured">
                <phone
                        jcr:primaryType="nt:unstructured"
                        title="Smaller Screen"
                        width="{Long}768"/>
                <tablet
                        jcr:primaryType="nt:unstructured"
                        title="Tablet"
                        width="{Long}1200"/>
            </breakpoints>
        </cq:responsive>
    </jcr:content>
</jcr:root>
