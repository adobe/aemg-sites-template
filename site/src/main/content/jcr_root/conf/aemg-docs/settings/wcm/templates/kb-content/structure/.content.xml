<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:deviceGroups="[mobile/groups/responsive]"
        cq:lastModified="{Date}2021-01-14T10:04:39.084-07:00"
        cq:lastModifiedBy="admin"
        cq:template="/conf/aemg-docs/settings/wcm/templates/kb-content"
        jcr:primaryType="cq:PageContent"
        id="category-page"
        sling:resourceType="guides-components/components/page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="core/wcm/components/container/v1/container"
            layout="simple">
            <experiencefragment-header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/wcm/components/experiencefragment/v1/experiencefragment"
                fragmentVariationPath="/content/experience-fragments/aemg-docs/en/site/header/master"/>
            <status-banner
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/wcm/components/container/v1/container"
                id="status-banner">
                <status-dot-icon
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="status-dot-icon"/>
                <status-banner-text
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/text/v2/text"
                    text="&lt;p>Whatever message this page gives is out now!  &lt;a href='#'>Go check it out!&lt;/a>&lt;/p>"
                    textIsRich="true"
                    id="status-banner-text"/>
            </status-banner>
            <kb-page-container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/wcm/components/container/v1/container"
                id="kb-page-container">
                <kb-content-area
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="kb-content-area">
                    <breadcrumb
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/breadcrumb/v2/breadcrumb"
                        disableShadowing="false"
                        hideCurrent="false"
                        showHidden="false"
                        startLevel="3"/>
                    <title
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/title/v2/title"
                        id="kb-title"
                        type="h1"/>
                    <kb-last-update
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/container/v1/container"
                        id="kb-last-update">
                        <last-update-label
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="Last update:"
                            textIsRich="false"
                            id="kb-last-update-label"/>
                        <date
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="guides-components/components/pageproperty"
                            property="jcr:created"/>
                    </kb-last-update>
                    <description
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="guides-components/components/pageproperty"
                        property="jcr:description"
                        id="kb-description"/>
                    <topics-heading
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/title/v2/title"
                        jcr:title="User guide topics"
                        id="kb-topics-heading"
                        type="h2"/>
                    <categorylist
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="guides-components/components/categorylist"
                        parentPath="/content/aemg-docs/en/docs"/>
                </kb-content-area>
                <kb-sidebar
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="kb-sidebar">
                    <kb-download-card
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/container/v1/container"
                        id="kb-download-card">
                        <download-icon
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/container/v1/container"
                            id="kb-download-icon"/>
                        <download-title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="DOWNLOAD COLDFUSION TODAY"
                            textIsRich="false"
                            id="kb-download-title"/>
                        <download-text
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;p>Visit the Adobe ColdFusion User Community to be inspired and get answers to top questions.&lt;/p>"
                            textIsRich="true"
                            id="kb-download-text"/>
                        <download-btn
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;p>&lt;a href='#'>Download ColdFusion&lt;/a>&lt;/p>"
                            textIsRich="true"
                            id="kb-download-btn"/>
                        <download-learn
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;p>&lt;a href='#'>Learn more&lt;/a>&lt;/p>"
                            textIsRich="true"
                            id="kb-download-learn"/>
                    </kb-download-card>
                    <kb-sidebar-cards-row
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/container/v1/container"
                        id="kb-sidebar-cards-row">
                        <kb-community-card
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/container/v1/container"
                            id="kb-community-card">
                            <community-icon
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/wcm/components/container/v1/container"
                                id="kb-community-icon"/>
                            <community-title
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/wcm/components/text/v2/text"
                                text="JOIN THE CONVERSATION"
                                textIsRich="false"
                                id="kb-community-title"/>
                            <community-text
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/wcm/components/text/v2/text"
                                text="&lt;p>Visit the Adobe ColdFusion User Community to be inspired and get answers to top questions.&lt;/p>"
                                textIsRich="true"
                                id="kb-community-text"/>
                            <community-link
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/wcm/components/text/v2/text"
                                text="&lt;p>&lt;a href='#'>Visit community  &amp;gt;&lt;/a>&lt;/p>"
                                textIsRich="true"
                                id="kb-community-link"/>
                        </kb-community-card>
                        <kb-contact-card
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/container/v1/container"
                            id="kb-contact-card">
                            <contact-icon
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/wcm/components/container/v1/container"
                                id="kb-contact-icon"/>
                            <contact-title
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/wcm/components/text/v2/text"
                                text="CONTACT US"
                                textIsRich="false"
                                id="kb-contact-title"/>
                            <contact-text
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/wcm/components/text/v2/text"
                                text="&lt;p>Expert support for your issues.&lt;/p>"
                                textIsRich="true"
                                id="kb-contact-text"/>
                            <contact-link
                                jcr:primaryType="nt:unstructured"
                                sling:resourceType="core/wcm/components/text/v2/text"
                                text="&lt;p>&lt;a href='#'>Start now  &amp;gt;&lt;/a>&lt;/p>"
                                textIsRich="true"
                                id="kb-contact-link"/>
                        </kb-contact-card>
                    </kb-sidebar-cards-row>
                </kb-sidebar>
            </kb-page-container>
            <kb-promo-banner
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/wcm/components/container/v1/container"
                id="kb-promo-banner">
                <promo-icon
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="kb-promo-icon"/>
                <promo-content
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="kb-promo-content">
                    <promo-title-row
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/container/v1/container"
                        id="kb-promo-title-row">
                        <promo-title
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="&lt;p>&lt;b>ColdFusion 2025 update 12&lt;/b>&lt;/p>"
                            textIsRich="true"
                            id="kb-promo-title"/>
                        <promo-badge
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="core/wcm/components/text/v2/text"
                            text="February 2025"
                            textIsRich="false"
                            id="kb-promo-badge"/>
                    </promo-title-row>
                    <promo-description
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>Major release with new licensing models, custom MCP support and a brand new code editing experience!&lt;/p>"
                        textIsRich="true"
                        id="kb-promo-description"/>
                    <promo-link
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="core/wcm/components/text/v2/text"
                        text="&lt;p>&lt;a href='#'>View release notes&lt;/a>&lt;/p>"
                        textIsRich="true"
                        id="kb-promo-link"/>
                </promo-content>
            </kb-promo-banner>
            <share-this-page
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/wcm/components/container/v1/container"
                id="share-this-page">
                <share-label
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/text/v2/text"
                    text="Share this page"
                    textIsRich="false"
                    id="share-label"/>
                <share-facebook
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="share-facebook"/>
                <share-x
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="share-x"/>
                <share-linkedin
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="share-linkedin"/>
                <share-copylink
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="core/wcm/components/container/v1/container"
                    id="share-copylink"/>
            </share-this-page>
            <pagefeedback
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/pagefeedback"/>
            <experiencefragment-footer
                jcr:primaryType="nt:unstructured"
                sling:resourceType="core/wcm/components/experiencefragment/v1/experiencefragment"
                fragmentVariationPath="/content/experience-fragments/aemg-docs/en/site/footer/master"/>
        </root>
        <cq:responsive jcr:primaryType="nt:unstructured">
            <breakpoints jcr:primaryType="nt:unstructured">
                <phone
                    jcr:primaryType="nt:unstructured"
                    title="Smaller Screen"
                    width="{Long}768"/>
            </breakpoints>
        </cq:responsive>
    </jcr:content>
</jcr:root>
