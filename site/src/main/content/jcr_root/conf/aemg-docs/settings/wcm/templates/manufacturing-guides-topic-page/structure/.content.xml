<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
          xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
          jcr:primaryType="cq:Page">
    <jcr:content cq:deviceGroups="[mobile/groups/responsive]"
            cq:template="/conf/aemg-docs/settings/wcm/templates/manufacturing-guides-topic-page"
            jcr:primaryType="cq:PageContent"
            sling:resourceType="guides-components/components/guides-pages/manufacturing/manufacturing-guides-topic-page">
        <root jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/container"
                layout="responsiveGrid">
            <breadcrumb
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="guides-components/components/breadcrumb2"
                    arrowIcon="/content/dam/aemg-docs/common-images/icons/right-arrow-gray.svg"
                    homeIcon="/content/dam/aemg-docs/common-images/icons/home.svg"
					disableShadowing="false"
                    hideCurrent="false"
                    showHidden="false"
                    startLevel="5"/>
            <container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="guides-components/components/container"
                    editable="{Boolean}true"
                    layout="responsiveGrid"/>
            <custom_container
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="guides-components/components/custom-container"
                    colLayout="threeColumn">
                <gu1
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="wcm/foundation/components/parsys">
                </gu1>
                <gu2
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="wcm/foundation/components/parsys">
                    <topic_renderer
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="guides-components/components/topic-renderer"/>
                    <prev_next_topic
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="guides-components/components/prev-next-topic"
                            nextLabel="Next Topic"
                            previousLabel="Previous Topic"/>
                    <feedback
                            jcr:primaryType="nt:unstructured"
                            title="Was this information helpful?"
                            sling:resourceType="guides-components/components/feedback"/>
                </gu2>
                <gu3
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="wcm/foundation/components/parsys">
                    <tableofcontents
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="guides-components/components/tableofcontents"
                            listType="bulleted"
                            startLevel="h2"
                            stopLevel="h2"/>
                    <related_tags
                            jcr:primaryType="nt:unstructured"
                            sling:resourceType="guides-components/components/related-tags"
                            headline="Related Tags"/>
                </gu3>
            </custom_container>
        </root>
        <cq:responsive jcr:primaryType="nt:unstructured">
            <breakpoints jcr:primaryType="nt:unstructured">
                <phone jcr:primaryType="nt:unstructured"
                        title="Smaller Screen"
                        width="{Long}768"/>
                <tablet jcr:primaryType="nt:unstructured"
                        title="Tablet"
                        width="{Long}1200"/>
            </breakpoints>
        </cq:responsive>
    </jcr:content>
</jcr:root>
