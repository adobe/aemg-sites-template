<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:deviceGroups="[mobile/groups/responsive]"
        cq:template="/conf/hitech/settings/wcm/templates/hi-tech-guides-topic-page"
        jcr:primaryType="cq:PageContent"
        sling:resourceType="guides-components/components/guides-pages/hi-tech/hi-tech-guides-topic-page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="guides-components/components/container"
            layout="responsiveGrid">
            <experiencefragment-header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/experiencefragment"
                fragmentVariationPath="/content/experience-fragments/hitech/en/us/header/master"/>
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/container"
                editable="{Boolean}true"
                layout="responsiveGrid"/>
            <experiencefragment
                jcr:created="{Date}2024-12-17T14:36:22.609+05:30"
                jcr:createdBy="admin"
                jcr:lastModified="{Date}2024-12-19T16:39:21.406+05:30"
                jcr:lastModifiedBy="admin"
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/experiencefragment"
                fragmentVariationPath="/content/experience-fragments/hitech/en/us/footer/master"/>
        </root>
        <cq:responsive jcr:primaryType="nt:unstructured">
            <breakpoints jcr:primaryType="nt:unstructured">
                <phone
                    jcr:primaryType="nt:unstructured"
                    title="Smaller Screen"
                    width="{Long}768"/>
                <tablet
                    jcr:primaryType="nt:unstructured"
                    title="Tablet"
                    width="{Long}1200"/>
            </breakpoints>
        </cq:responsive>
    </jcr:content>
</jcr:root>
