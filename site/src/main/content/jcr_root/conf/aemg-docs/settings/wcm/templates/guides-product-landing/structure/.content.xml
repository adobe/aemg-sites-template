<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:sling="http://sling.apache.org/jcr/sling/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:deviceGroups="[mobile/groups/responsive]"
        cq:template="/conf/aemg-docs/settings/wcm/templates/guides-product-page-template"
        jcr:primaryType="cq:PageContent"
        sling:resourceType="guides-components/components/guides-pages/base/guides-product-page">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="guides-components/components/container"
            layout="responsiveGrid">
            <experiencefragment-header
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/experiencefragment"
                fragmentVariationPath="/content/experience-fragments/aemg-docs/hitech/en/us/header/master"/>
            <banner_component
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="guides-components/components/banner"
                    ctaLabel="Get Started"
                    ctaLink="#"
                    description="Comprehensive guides ensuring seamless integration, optimal performance, and efficient troubleshooting of advanced technologies"
                    title="Product Documentation"
                    bannerImage="/content/dam/aemg-docs/common-images/banner-cover.svg"/>
            <product_card
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="guides-components/components/product-card"
                    rootPath="/content/output/sites/guides/en/en_us"
                    nextIcon="/content/dam/aemg-docs/common-images/icons/next.svg"
                    prevIcon="/content/dam/aemg-docs/common-images/icons/previous.svg"
                    productIconPath="/content/dam/aemg-docs/common-images/icons/product-icon.svg"/>
            <container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/container"
                editable="{Boolean}true"
                layout="responsiveGrid"/>
            <experiencefragment
                jcr:primaryType="nt:unstructured"
                sling:resourceType="guides-components/components/experiencefragment"
                fragmentVariationPath="/content/experience-fragments/aemg-docs/hitech/en/us/footer/master"/>
        </root>
        <cq:responsive jcr:primaryType="nt:unstructured">
            <breakpoints jcr:primaryType="nt:unstructured">
                <phone
                    jcr:primaryType="nt:unstructured"
                    title="Smaller Screen"
                    width="{Long}768"/>
                <tablet
                    jcr:primaryType="nt:unstructured"
                    title="Tablet"
                    width="{Long}1200"/>
            </breakpoints>
        </cq:responsive>
    </jcr:content>
</jcr:root>
